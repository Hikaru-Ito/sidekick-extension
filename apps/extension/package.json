{
  "name": "@sidekick/extension",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Sidekick — a productivity-packed Chrome extension.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "echo \"(lint to be configured)\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .output .wxt .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@sidekick/config": "workspace:*",
    "@sidekick/ui-kit": "workspace:*",
    "idb": "^8.0.3",
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@sidekick/tsconfig": "workspace:*",
    "@types/chrome": "^0.0.275",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@wxt-dev/module-react": "1.1.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "wxt": "^0.19.13"
  }
}
