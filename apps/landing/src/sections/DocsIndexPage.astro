---
import BaseLayout from '../layouts/BaseLayout.astro';
import { features, localize } from '../data/features';
import { t } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const docs = [
  { href: `${baseUrl}${localizePath('/install', locale)}`, label: t(locale, 'docs.linkInstall') },
  {
    href: `${baseUrl}${localizePath('/docs/contributing', locale)}`,
    label: t(locale, 'docs.linkContributing'),
  },
  {
    href: `${baseUrl}${localizePath('/docs/architecture', locale)}`,
    label: t(locale, 'docs.linkArchitecture'),
  },
  {
    href: `${baseUrl}${localizePath('/docs/design-system', locale)}`,
    label: t(locale, 'docs.linkDesignSystem'),
  },
];

const localizedFeatures = features.map((f) => localize(f, locale));
---

<BaseLayout locale={locale} title={`Sidekick — ${t(locale, 'docs.title')}`}>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <h1 class="text-4xl font-semibold tracking-tight">{t(locale, 'docs.title')}</h1>
    <p class="text-fg-muted mt-3">{t(locale, 'docs.subtitle')}</p>

    <div class="mt-10">
      <h2 class="text-lg font-semibold">{t(locale, 'docs.guides')}</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          docs.map((doc) => (
            <li>
              <a
                href={doc.href}
                class="border-border bg-surface-elevated hover:bg-surface-muted flex items-center justify-between rounded-lg border px-4 py-3 text-sm transition-colors"
              >
                {doc.label}
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 18l6-6-6-6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="text-lg font-semibold">{t(locale, 'docs.featureReference')}</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          localizedFeatures.map((f) => (
            <li>
              <a
                href={`${baseUrl}${localizePath(`/docs/features/${f.id}`, locale)}`}
                class="border-border bg-surface-elevated hover:bg-surface-muted flex items-center justify-between rounded-lg border px-4 py-3 text-sm transition-colors"
              >
                <span>
                  <span class="font-medium">{f.name}</span>
                  <span class="text-fg-muted ml-2 text-xs">{f.description}</span>
                </span>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 18l6-6-6-6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
