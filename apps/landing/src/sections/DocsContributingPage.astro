---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const copy = {
  en: {
    title: 'Contributing',
    subtitle: 'Anyone can add a feature to Sidekick. One feature = one directory.',
    setup: 'Setup',
    addFeature: 'Adding a feature',
    scaffolder: 'Scaffold a feature with:',
    generated: 'This creates:',
    autoregister:
      'registry.ts auto-collects the new feature, so it appears in the popup with no extra wiring.',
    prChecks: 'Before opening a PR',
    pr: [
      '`pnpm typecheck` passes',
      '`pnpm format:check` passes',
      'Feature added: `docs/features/<id>.md` is filled in',
      'Feature added: `apps/landing/src/data/features.ts` has the entry',
      '`pnpm changeset` recorded',
    ],
  },
  ja: {
    title: 'コントリビューションガイド',
    subtitle: 'Sidekick は誰でも機能を追加できます。1機能 = 1ディレクトリのシンプルな構造です。',
    setup: 'セットアップ',
    addFeature: '新機能を追加する',
    scaffolder: 'scaffolderで雛形を生成:',
    generated: 'これで以下が自動生成されます:',
    autoregister: 'registry.ts が自動的にこの機能を読み込み、ポップアップメニューに表示されます。',
    prChecks: 'PRを送る前に',
    pr: [
      '`pnpm typecheck` が通ること',
      '`pnpm format:check` で整形されていること',
      '機能の説明と権限を `apps/landing/src/data/features.ts` に追記すること',
      '`docs/features/<id>.md` を埋めること',
      '`pnpm changeset` で変更点を記録すること',
    ],
  },
}[locale];

function code(s: string): string {
  return s.replaceAll(
    /`([^`]+)`/g,
    '<code class="bg-surface-muted rounded px-1.5 py-0.5 text-xs">$1</code>',
  );
}
---

<BaseLayout locale={locale} title={`Sidekick — ${copy.title}`}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a
      href={`${baseUrl}${localizePath('/docs', locale)}`}
      class="text-fg-muted hover:text-fg-default text-sm">{t(locale, 'docs.back')}</a
    >
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">{copy.title}</h1>
    <p class="text-fg-muted mt-3">{copy.subtitle}</p>

    <section class="text-fg-muted mt-10 space-y-8 text-sm leading-relaxed">
      <div>
        <h2 class="text-fg-default text-xl font-semibold">{copy.setup}</h2>
        <div
          class="border-border mt-3 overflow-hidden rounded-lg border bg-neutral-950 font-mono text-xs text-neutral-200"
        >
          <pre
            class="overflow-x-auto p-4"><code>git clone https://github.com/Hikaru-Ito/sidekick-extension.git
cd sidekick-extension
pnpm install
pnpm dev   # extension + landing in parallel</code></pre>
        </div>
      </div>

      <div>
        <h2 class="text-fg-default text-xl font-semibold">{copy.addFeature}</h2>
        <p class="mt-2">{copy.scaffolder}</p>
        <div
          class="border-border mt-3 overflow-hidden rounded-lg border bg-neutral-950 font-mono text-xs text-neutral-200"
        >
          <pre
            class="overflow-x-auto p-4"><code>pnpm gen:feature &lt;feature-id&gt;
# example
pnpm gen:feature word-counter</code></pre>
        </div>
        <p class="mt-3">{copy.generated}</p>
        <ul class="mt-2 list-disc space-y-1 pl-6">
          <li>
            <code class="bg-surface-muted rounded px-1.5 py-0.5 text-xs"
              >apps/extension/src/features/&lt;id&gt;/manifest.ts</code
            >
          </li>
          <li>
            <code class="bg-surface-muted rounded px-1.5 py-0.5 text-xs"
              >apps/extension/src/features/&lt;id&gt;/Panel.tsx</code
            >
          </li>
          <li>
            <code class="bg-surface-muted rounded px-1.5 py-0.5 text-xs"
              >docs/features/&lt;id&gt;.md</code
            >
          </li>
        </ul>
        <p class="mt-3">{copy.autoregister}</p>
      </div>

      <div>
        <h2 class="text-fg-default text-xl font-semibold">{copy.prChecks}</h2>
        <ul class="mt-3 list-disc space-y-1 pl-6">
          {copy.pr.map((item) => <li set:html={code(item)} />)}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
