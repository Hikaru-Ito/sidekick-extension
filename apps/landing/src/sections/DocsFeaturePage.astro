---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/types';
import type { LocalizedFeature } from '../data/features';
import { hasDemo, demoUrl } from '../lib/demos';

interface Props {
  locale: Locale;
  feature: LocalizedFeature;
}

const { locale, feature } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const showDemo = hasDemo(feature.id);
const demoSrc = showDemo ? demoUrl(baseUrl, feature.id) : null;

const usageCopy = {
  en: {
    usage: [
      'Click the Sidekick icon in the toolbar',
      'Pick "Auto Reload" from the menu',
      'Choose a preset (15 sec – 1 hour) or enter a custom interval',
      'Toggle on. The active tab starts auto-reloading',
    ],
    implementationTitle: 'Implementation notes',
    implementation: [
      'Intervals ≥1 min run via chrome.alarms (low overhead)',
      'Intervals <1 min run via setTimeout inside the service worker',
      'Settings are saved to chrome.storage.local and tracked per tab',
      'State is cleaned up when the tab closes',
    ],
  },
  ja: {
    usage: [
      'ツールバーのSidekickアイコンをクリック',
      'メニューから「定期リロード」を選択',
      'プリセット (15秒〜1時間) またはカスタム秒数を指定',
      'トグルをONにすると現在のタブが自動でリロードされ始める',
    ],
    implementationTitle: '技術的な詳細',
    implementation: [
      '1分以上の間隔は chrome.alarms で省リソース実行',
      '1分未満は service worker 内の setTimeout で実行',
      '設定は chrome.storage.local に保存。タブごとに管理',
      'タブが閉じられると自動でクリーンアップ',
    ],
  },
}[locale];
---

<BaseLayout
  locale={locale}
  title={`${feature.name} | Sidekick docs`}
  description={feature.description}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a
      href={`${baseUrl}${localizePath('/docs', locale)}`}
      class="text-fg-muted hover:text-fg-default text-sm">{t(locale, 'docs.back')}</a
    >
    <header class="mt-4">
      <div class="flex items-center gap-3">
        <span
          class="bg-accent-500/12 text-accent-700 dark:text-accent-300 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
          >{feature.category}</span
        >
        <span
          class="bg-success/12 text-success rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
          >{feature.status}</span
        >
      </div>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight">{feature.name}</h1>
      <p class="text-fg-muted mt-3">{feature.description}</p>
    </header>

    {
      showDemo && demoSrc ? (
        <section class="mt-8">
          <h2 class="text-fg-default mb-3 text-lg font-semibold">
            {t(locale, 'feature.section.demo')}
          </h2>
          <div class="border-border bg-surface-muted/40 mx-auto w-fit overflow-hidden rounded-2xl border p-3 shadow-md">
            <video
              src={demoSrc}
              controls
              muted
              loop
              autoplay
              playsinline
              preload="metadata"
              class="block max-h-[640px] w-[380px] max-w-full rounded-lg bg-black"
            />
          </div>
        </section>
      ) : null
    }

    <section class="prose prose-zinc dark:prose-invert mt-10 max-w-none">
      <h2 class="text-lg font-semibold">{t(locale, 'feature.section.highlights')}</h2>
      <ul class="text-fg-muted mt-3 space-y-2 text-sm">
        {
          feature.highlights.map((h) => (
            <li class="flex items-start gap-2">
              <span class="bg-accent-500 mt-1.5 h-1 w-1 shrink-0 rounded-full" />
              <span>{h}</span>
            </li>
          ))
        }
      </ul>

      {
        feature.id === 'auto-reload' && (
          <div class="mt-8 space-y-6">
            <div>
              <h2 class="text-lg font-semibold">{t(locale, 'feature.section.usage')}</h2>
              <ol class="text-fg-muted mt-3 space-y-3 text-sm">
                {usageCopy.usage.map((step, i) => (
                  <li>
                    {i + 1}. {step}
                  </li>
                ))}
              </ol>
            </div>
            <div>
              <h2 class="text-lg font-semibold">{usageCopy.implementationTitle}</h2>
              <ul class="text-fg-muted mt-3 space-y-2 text-sm">
                {usageCopy.implementation.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        )
      }
    </section>
  </article>
</BaseLayout>
