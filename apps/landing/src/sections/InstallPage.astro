---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const steps = [
  [t(locale, 'install.optionBStep1'), 'github.com/Hikaru-Ito/sidekick-extension/releases'],
  [t(locale, 'install.optionBStep2'), null],
  [t(locale, 'install.optionBStep3'), null],
  [t(locale, 'install.optionBStep4'), null],
  [t(locale, 'install.optionBStep5'), null],
  [t(locale, 'install.optionBStep6'), null],
] as const;
---

<BaseLayout locale={locale} title={`Sidekick — ${t(locale, 'install.title')}`}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <h1 class="text-4xl font-semibold tracking-tight">{t(locale, 'install.title')}</h1>
    <p class="text-fg-muted mt-3">{t(locale, 'install.subtitle')}</p>

    <div class="mt-12 space-y-12">
      <!-- Option A: Web Store -->
      <div>
        <div class="flex items-center gap-3">
          <span
            class="bg-accent-500/12 text-accent-700 dark:text-accent-300 flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
            >A</span
          >
          <h2 class="text-xl font-semibold">{t(locale, 'install.optionA')}</h2>
        </div>
        <p class="text-fg-muted mt-3 text-sm">{t(locale, 'install.optionADesc')}</p>
        <a
          href="#"
          aria-disabled="true"
          class="border-border bg-surface-muted text-fg-subtle mt-4 inline-flex h-10 cursor-not-allowed items-center gap-2 rounded-md border px-4 text-sm font-medium"
        >
          {t(locale, 'install.optionAButton')}
        </a>
      </div>

      <!-- Option B: zip -->
      <div>
        <div class="flex items-center gap-3">
          <span
            class="bg-success/15 text-success flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
            >B</span
          >
          <h2 class="text-xl font-semibold">{t(locale, 'install.optionB')}</h2>
        </div>
        <ol class="mt-4 space-y-4">
          {
            steps.map(([step, hint], i) => (
              <li class="flex gap-3">
                <span class="border-border bg-surface-elevated text-fg-muted flex h-6 w-6 shrink-0 items-center justify-center rounded-full border text-xs font-semibold">
                  {i + 1}
                </span>
                <div>
                  <p class="text-fg-default text-sm">{step}</p>
                  {hint ? (
                    <code class="bg-surface-muted text-fg-muted mt-1 inline-block rounded px-1.5 py-0.5 font-mono text-xs">
                      {hint}
                    </code>
                  ) : null}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Option C: source -->
      <div>
        <div class="flex items-center gap-3">
          <span
            class="bg-info/15 text-info flex h-8 w-8 items-center justify-center rounded-full text-sm font-semibold"
            >C</span
          >
          <h2 class="text-xl font-semibold">{t(locale, 'install.optionC')}</h2>
        </div>
        <p class="text-fg-muted mt-3 text-sm">{t(locale, 'install.optionCDesc')}</p>
        <div
          class="border-border mt-4 overflow-hidden rounded-lg border bg-neutral-950 font-mono text-xs text-neutral-200"
        >
          <div class="border-b border-neutral-800 px-3 py-1.5 text-[11px] text-neutral-500">
            terminal
          </div>
          <pre
            class="overflow-x-auto p-4 leading-relaxed"><code>git clone https://github.com/Hikaru-Ito/sidekick-extension.git
cd sidekick-extension
pnpm install
pnpm --filter @sidekick/extension build

# Load .output/chrome-mv3/ via chrome://extensions</code></pre>
        </div>
      </div>

      <!-- Permissions -->
      <div class="border-border bg-surface-muted/50 rounded-xl border p-6">
        <h3 class="text-sm font-semibold">{t(locale, 'install.permissions')}</h3>
        <p class="text-fg-muted mt-2 text-sm leading-relaxed">
          {t(locale, 'install.permissionsDesc')}
        </p>
        <ul class="text-fg-muted mt-3 space-y-1.5 text-sm">
          <li>
            <code class="bg-surface rounded px-1.5 py-0.5 text-xs">tabs</code> — {
              t(locale, 'install.permTabs')
            }
          </li>
          <li>
            <code class="bg-surface rounded px-1.5 py-0.5 text-xs">alarms</code> — {
              t(locale, 'install.permAlarms')
            }
          </li>
          <li>
            <code class="bg-surface rounded px-1.5 py-0.5 text-xs">storage</code> — {
              t(locale, 'install.permStorage')
            }
          </li>
          <li>
            <code class="bg-surface rounded px-1.5 py-0.5 text-xs">scripting</code> — {
              t(locale, 'install.permScripting')
            }
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
