---
import DocsFeaturePage from '../../../sections/DocsFeaturePage.astro';
import { features, plannedFeatures, localize } from '../../../data/features';

export function getStaticPaths() {
  return [...features, ...plannedFeatures].map((feature) => ({
    params: { id: feature.id },
    props: { feature: localize(feature, 'en') },
  }));
}

const { feature } = Astro.props;
---

<DocsFeaturePage locale="en" feature={feature} />
