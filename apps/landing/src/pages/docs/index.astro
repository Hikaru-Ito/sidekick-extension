---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { features } from '../../data/features';

const docs = [
  { href: '/install', label: 'インストール手順' },
  { href: '/docs/contributing', label: 'コントリビューションガイド' },
  { href: '/docs/architecture', label: 'アーキテクチャ概要' },
  { href: '/docs/design-system', label: 'デザインシステム' },
];
---

<BaseLayout title="Sidekick ドキュメント">
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <h1 class="text-4xl font-semibold tracking-tight">ドキュメント</h1>
    <p class="mt-3 text-fg-muted">
      使い方ガイド、機能リファレンス、コントリビュータ向けドキュメント。
    </p>

    <div class="mt-10">
      <h2 class="text-lg font-semibold">ガイド</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {docs.map((doc) => (
          <li>
            <a
              href={doc.href}
              class="flex items-center justify-between rounded-lg border border-border bg-surface-elevated px-4 py-3 text-sm transition-colors hover:bg-surface-muted"
            >
              {doc.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="text-lg font-semibold">機能リファレンス</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {features.map((f) => (
          <li>
            <a
              href={`/docs/features/${f.id}`}
              class="flex items-center justify-between rounded-lg border border-border bg-surface-elevated px-4 py-3 text-sm transition-colors hover:bg-surface-muted"
            >
              <span>
                <span class="font-medium">{f.name}</span>
                <span class="ml-2 text-xs text-fg-muted">{f.description}</span>
              </span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
