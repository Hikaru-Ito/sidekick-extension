---
import BaseLayout from '../layouts/BaseLayout.astro';
import { features, plannedFeatures } from '../data/features';

const categoryColors: Record<string, string> = {
  automation: 'bg-accent-500/12 text-accent-600',
  productivity: 'bg-success/12 text-success',
  developer: 'bg-info/12 text-info',
  privacy: 'bg-warning/15 text-warning',
  lifestyle: 'bg-danger/12 text-danger',
};
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0 -z-10"></div>
    <div class="mx-auto max-w-6xl px-4 pb-20 pt-20 sm:px-6 sm:pt-28">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-elevated px-3 py-1 text-xs font-medium text-fg-muted shadow-xs"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
          v0.1.0 がリリースされました
        </span>
        <h1
          class="mt-6 text-4xl font-semibold tracking-tight text-fg-default sm:text-5xl md:text-6xl"
        >
          毎日のブラウザに、<br />
          <span
            class="bg-gradient-to-r from-accent-500 via-accent-600 to-accent-800 bg-clip-text text-transparent"
          >
            頼れる相棒を
          </span>
        </h1>
        <p
          class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-fg-muted sm:text-lg"
        >
          Sidekick は便利機能を一つの拡張にまとめた、オープンソースの Chrome 拡張機能です。
          単機能拡張を何個も入れる代わりに、Sidekick 一つで生産性を底上げします。
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/install"
            class="inline-flex h-11 items-center justify-center gap-2 rounded-md bg-accent-600 px-6 text-sm font-medium text-white shadow-sm transition-all hover:bg-accent-700 hover:shadow-md"
          >
            Chromeに追加する
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="https://github.com/Hikaru-Ito/sidekick-extension"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center justify-center gap-2 rounded-md border border-border bg-surface-elevated px-6 text-sm font-medium text-fg-default shadow-xs transition-all hover:bg-surface-muted"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            GitHubで見る
          </a>
        </div>
        <p class="mt-4 text-xs text-fg-subtle">
          MITライセンス · Manifest V3 · プライバシーフレンドリー
        </p>
      </div>

      <!-- Popup preview mockup -->
      <div class="mt-16 flex justify-center">
        <div
          class="relative w-full max-w-md rounded-2xl border border-border bg-surface-elevated shadow-2xl"
        >
          <div class="flex h-12 items-center gap-2 border-b border-border px-3">
            <div class="flex h-7 w-7 items-center justify-center rounded-md bg-accent-500/12 text-accent-600">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <span class="text-sm font-semibold">Sidekick</span>
            <span class="ml-auto text-[11px] text-fg-subtle">便利機能をひとつに</span>
          </div>
          <div class="space-y-3 p-3">
            <div class="text-[10px] font-semibold uppercase tracking-wider text-fg-subtle px-1.5">Automation</div>
            <div class="rounded-lg border border-border bg-surface-elevated">
              <div class="flex items-center gap-3 px-3 py-2.5">
                <div class="flex h-9 w-9 items-center justify-center rounded-md bg-accent-500/12 text-accent-600">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium">定期リロード</div>
                  <div class="text-xs text-fg-muted">30秒毎に1タブ実行中</div>
                </div>
                <div class="h-[22px] w-[36px] rounded-full bg-accent-600 relative">
                  <div class="absolute right-0.5 top-0.5 h-[18px] w-[18px] rounded-full bg-white"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="text-center">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">利用できる機能</h2>
      <p class="mx-auto mt-3 max-w-2xl text-fg-muted">
        Sidekick はモジュラー設計。新しい機能はOSSとして継続的に追加されます。
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <a
          href={`/docs/features/${feature.id}`}
          class="group flex flex-col rounded-xl border border-border bg-surface-elevated p-6 shadow-xs transition-all hover:-translate-y-0.5 hover:shadow-md"
        >
          <div class="flex items-center gap-3">
            <span class={`flex h-10 w-10 items-center justify-center rounded-lg ${categoryColors[feature.category]}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
            </span>
            <span class="rounded-full bg-success/12 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-success">Stable</span>
          </div>
          <h3 class="mt-4 text-base font-semibold">{feature.name}</h3>
          <p class="mt-1 text-sm text-fg-muted">{feature.description}</p>
          <ul class="mt-4 space-y-1.5">
            {feature.highlights.map((h) => (
              <li class="flex items-start gap-2 text-xs text-fg-muted">
                <span class="mt-1 h-1 w-1 shrink-0 rounded-full bg-accent-500"></span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </a>
      ))}

      {plannedFeatures.map((feature) => (
        <div class="flex flex-col rounded-xl border border-dashed border-border bg-surface-muted/40 p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-fg-subtle/10 text-fg-subtle">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <span class="rounded-full bg-surface-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-fg-muted">Planned</span>
          </div>
          <h3 class="mt-4 text-base font-semibold text-fg-muted">{feature.name}</h3>
          <p class="mt-1 text-sm text-fg-subtle">{feature.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Architecture / Open Source -->
  <section class="border-y border-border bg-surface-muted/40">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">完全にオープンソース</h2>
        <p class="mt-3 text-fg-muted leading-relaxed">
          Sidekick の全コードは GitHub で公開されています。プライバシーポリシーや権限が透明で、
          コミュニティが機能を提案・実装できます。
        </p>
        <ul class="mt-6 space-y-3">
          {[
            ['MIT License', '商用・個人利用ともに自由'],
            ['Manifest V3', 'Chrome の最新拡張機能仕様に準拠'],
            ['TypeScript + WXT', 'モダンなビルドツールチェーン'],
            ['Modular architecture', 'features/ 配下に1機能=1ディレクトリで追加可能'],
          ].map(([title, desc]) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-success/12 text-success">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <div>
                <div class="text-sm font-medium">{title}</div>
                <div class="text-xs text-fg-muted">{desc}</div>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-xl border border-border bg-surface-elevated p-6 font-mono text-xs leading-relaxed">
        <div class="text-fg-subtle"># 機能追加ルール (manifest駆動)</div>
        <pre class="mt-2 overflow-x-auto text-fg-default">{`apps/extension/src/features/<feature-id>/
├── manifest.ts          # 機能宣言 (id/name/category/...)
├── Panel.tsx            # ポップアップUI
├── Summary.tsx?         # ホーム画面のサマリ表示
├── background.ts?       # service worker
└── storage.ts?          # 設定永続化

# 自動で登録 (registry.tsがimport.meta.globで収集)
# LP/docs/ にも同IDのファイルを追加すればOK`}</pre>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">今すぐ始める</h2>
    <p class="mx-auto mt-3 max-w-xl text-fg-muted">
      数分でインストールして、毎日のブラウジングを快適に。
    </p>
    <a
      href="/install"
      class="mt-8 inline-flex h-11 items-center justify-center gap-2 rounded-md bg-accent-600 px-8 text-sm font-medium text-white shadow-sm transition-all hover:bg-accent-700"
    >
      インストール手順を見る
    </a>
  </section>
</BaseLayout>
