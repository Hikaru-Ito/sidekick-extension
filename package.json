{
  "name": "sidekick-extension",
  "version": "0.5.0",
  "private": true,
  "description": "Sidekick — an open-source Chrome extension packed with useful productivity utilities.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx,json,astro,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,mdx,json,astro,css}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "gen:feature": "node scripts/scaffold-feature.mjs",
    "verify:extension": "pnpm --filter @sidekick/extension build && node scripts/verify-extension.mjs",
    "record:demos": "pnpm --filter @sidekick/extension build && node scripts/record-demos.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.7.5",
    "playwright": "^1.60.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  }
}
